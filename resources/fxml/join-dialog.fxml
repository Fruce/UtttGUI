<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Tooltip?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="sceneControllers.JoinController"
           stylesheets="@menu.css"
           style="-fx-background-color: #0f0f0f;">

    <!-- Wrapper used by ResizableScene -->
    <StackPane fx:id="joinWrapper" alignment="CENTER">

        <!-- Fixed-size root (scaled uniformly) -->
        <StackPane fx:id="joinRoot" alignment="CENTER">

            <VBox alignment="CENTER" spacing="22" styleClass="settings-root">

                <Label text="ENTER JOIN CODE"
                       style="-fx-text-fill: white; -fx-font-size: 22px;"/>

                <!-- Code field + paste button -->
				<GridPane alignment="CENTER" hgap="14">
				
				    <columnConstraints>
				        <ColumnConstraints prefWidth="42"/>
				        <ColumnConstraints halignment="CENTER"/>
				        <ColumnConstraints halignment="LEFT"/>
				    </columnConstraints>
				
				    <Region GridPane.columnIndex="0"/>
				
				    <TextField fx:id="addressField"
				               GridPane.columnIndex="1"
				               promptText="ENTER JOIN CODE"
				               prefWidth="380"
           					   maxWidth="380"
				               styleClass="settings-field"
				               style = "-fx-alignment: center; fx-font-size: 16"/>
				
				    <Button fx:id="pasteButton"
				            GridPane.columnIndex="2"
				            onAction="#pasteCode"
				            styleClass="icon-button">
				        <tooltip>
				            <Tooltip text="Paste"
				            styleClass="tooltip"/>
				        </tooltip>
				        <graphic>
				            <ImageView fitWidth="21"
				                       fitHeight="21"
				                       preserveRatio="true">
				                <image>
				                    <Image url="@/icons/paste.png"/>
				                </image>
				            </ImageView>
				        </graphic>
				    </Button>
				
				</GridPane>

                <!-- Buttons -->
                <HBox alignment="CENTER" spacing="26">

                    <Button text="BACK"
                            onAction="#back"
                            prefWidth="120"
                            prefHeight="44"
                            minHeight="44"
                            styleClass="menu-button-secondary"/>

                    <Button text="JOIN"
                            onAction="#connect"
                            prefWidth="120"
                            prefHeight="44"
                            minHeight="44"
                            styleClass="menu-button"/>

                </HBox>

            </VBox>

        </StackPane>
    </StackPane>
</StackPane>
