<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.Priority?>

<StackPane
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:id="settingsWrapper"
    fx:controller="sceneControllers.SettingsController"
    stylesheets="@menu.css"
    alignment = "TOP_LEFT"
    style="-fx-background-color: #0f0f0f;">

    <!-- Fixed-size root (scaled by ResizableScene) -->
    <StackPane fx:id="settingsRoot" style="-fx-padding: 80 0 0 80;">

        <VBox
            spacing="34"
            alignment="TOP_LEFT"
            styleClass="settings-root"
            style="-fx-padding: 40 0 0 40;"
            maxWidth="560">

            <!-- USERNAME -->
            <VBox spacing="10">
                <Label text="USERNAME"
                       styleClass="settings-label"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="usernameField"
                               styleClass="settings-field"
                               style = "fx-font-size: 25"
                               HBox.hgrow="ALWAYS"/>

                    <Button onAction="#saveUsername"
                    			fx:id="saveUsernameButton"
                            styleClass="icon-button">
                        <tooltip>
                            <Tooltip text="Save" styleClass="tooltip"/>
                        </tooltip>
                        <graphic>
                            <ImageView fitWidth="22"
                                       fitHeight="22"
                                       preserveRatio="true">
                                <image>
                                    <Image url="@/icons/save.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

            <Label fx:id="statusLabel"
                   styleClass="settings-status"/>

            <Button text="BACK"
                    onAction="#back"
                    styleClass="menu-button-secondary"/>

        </VBox>
    </StackPane>
</StackPane>
