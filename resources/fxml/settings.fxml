<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="sceneControllers.SettingsController"
           stylesheets="@menu.css"
           style="-fx-background-color: #0f0f0f;">

    <StackPane fx:id="settingsWrapper" alignment="CENTER">

        <StackPane fx:id="settingsRoot" alignment="CENTER">

            <VBox alignment="CENTER" spacing="26">

                <!-- ================= NGROK ================= -->

                <Label text="NGROK AUTH TOKEN"
                       style="-fx-text-fill: white; -fx-font-size: 22px;"/>

                <GridPane alignment="CENTER" hgap="12">
                    <columnConstraints>
                        <!-- Left spacer -->
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <!-- TextField -->
                        <ColumnConstraints/>
                        <!-- Save button -->
                        <ColumnConstraints/>
                    </columnConstraints>

                    <TextField fx:id="tokenField"
                               GridPane.columnIndex="1"
                               prefWidth="420"
                               promptText="Enter ngrok auth token"/>

                    <Button text="SAVE"
                            GridPane.columnIndex="2"
                            onAction="#saveToken"
                            prefWidth="90"
                            styleClass="menu-button"/>
                </GridPane>

                <!-- ================= USERNAME ================= -->

                <Label text="USERNAME"
                       style="-fx-text-fill: white; -fx-font-size: 18px;"/>

                <GridPane alignment="CENTER" hgap="12">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints/>
                        <ColumnConstraints/>
                    </columnConstraints>

                    <TextField fx:id="usernameField"
                               GridPane.columnIndex="1"
                               prefWidth="420"
                               promptText="Enter your username"/>

                    <Button text="SAVE"
                            GridPane.columnIndex="2"
                            onAction="#saveUsername"
                            prefWidth="90"
                            styleClass="menu-button"/>
                </GridPane>

                <!-- STATUS -->
                <Label fx:id="statusLabel"
                       text=""
                       style="-fx-text-fill: #aaaaaa;"/>

                <!-- BACK -->
                <Button text="BACK"
                        onAction="#back"
                        prefWidth="110"
                        prefHeight="20"
                        styleClass="menu-button-secondary"/>

            </VBox>

        </StackPane>

    </StackPane>

</StackPane>
