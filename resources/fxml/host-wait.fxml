<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="sceneControllers.HostWaitController"
           stylesheets="@menu.css"
           style="-fx-background-color: #0f0f0f;">
	           
	<StackPane fx:id="hostWrapper" alignment="CENTER">

        <!-- Fixed-size root that gets scaled -->
		<StackPane fx:id="hostRoot" alignment="CENTER">

		    <VBox alignment="CENTER" spacing="22">
		
		        <!-- TITLE -->
		        <Label text="HOSTING GAME"
		               style="-fx-text-fill: white;
		                      -fx-font-size: 28px;
		                      -fx-font-weight: bold;" />
		
		        <Region prefHeight="10"/>
		
		        <!-- JOIN CODE LABEL -->
		        <Label text="JOIN CODE"
		               style="-fx-text-fill: #aaaaaa;
		                      -fx-font-size: 14px;
		                      -fx-letter-spacing: 2px;" />
		
		        <!-- CODE + COPY (PERFECT CENTERING) -->
		        <GridPane fx:id="codeBox"
		                  alignment="CENTER"
		                  hgap="14"
		                  visible="false"
		                  managed="false">
		
		            <columnConstraints>
		                <!-- LEFT spacer: same width as button -->
		                <ColumnConstraints prefWidth="88"/>
		
		                <!-- CENTER: code -->
		                <ColumnConstraints halignment="CENTER"/>
		
		                <!-- RIGHT: copy button -->
		                <ColumnConstraints halignment="LEFT"/>
		            </columnConstraints>
		
		            <!-- LEFT SPACER -->
		            <Region GridPane.columnIndex="0"/>
		
		            <!-- CENTERED CODE -->
		            <Label fx:id="codeLabel"
		                   GridPane.columnIndex="1"
		                   text="------"
		                   style="-fx-text-fill: #f5c400;
		                          -fx-font-size: 32px;
		                          -fx-font-weight: bold;
		                          -fx-font-family: monospace;" />
		
		            <!-- COPY BUTTON -->
		            <Button fx:id="copyButton"
		                    GridPane.columnIndex="2"
		                    text="COPY"
		                    onAction="#copyCode"
		                    prefWidth="88"
		                    styleClass="menu-button"/>
		
		        </GridPane>
		
		        <!-- STATUS -->
		        <Label fx:id="statusLabel"
		               text="Starting server..."
		               style="-fx-text-fill: #cccccc;
		                      -fx-font-size: 14px;" />
		
		        <Region prefHeight="22"/>
		
		        <!-- LEAVE -->
		        <Button text="LEAVE"
		                onAction="#leave"
		                styleClass="menu-button-danger"/>
		
		    </VBox>
		</StackPane>
	</StackPane>
</StackPane>
