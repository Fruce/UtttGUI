<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="sceneControllers.HostWaitController"
           stylesheets="@menu.css"
           style="-fx-background-color: #0f0f0f;">

    <StackPane fx:id="hostWrapper" alignment="CENTER">

        <StackPane fx:id="hostRoot" alignment="CENTER">

            <VBox alignment="CENTER" spacing="22" styleClass="settings-root">

                <!-- TITLE -->
                <Label text="HOSTING GAME"
                       style="-fx-text-fill: white;
                              -fx-font-size: 28px;
                              -fx-font-weight: bold;" />

                <Region prefHeight="10"/>

                <!-- JOIN CODE LABEL -->
                <Label text="JOIN CODE"
                       style="-fx-text-fill: #aaaaaa;
                              -fx-font-size: 14px;
                              -fx-letter-spacing: 2px;" />

                <!-- CODE + COPY -->
                <GridPane fx:id="codeBox"
                          alignment="CENTER"
                          hgap="24"
                          visible="false"
                          managed="false">

                    <columnConstraints>
                        <ColumnConstraints prefWidth="44"/>
                        <ColumnConstraints halignment="CENTER"/>
                        <ColumnConstraints halignment="LEFT"/>
                    </columnConstraints>

                    <Region GridPane.columnIndex="0"/>
                    
                    <!-- JOIN CODE -->
                    <TextField fx:id="codeLabel"
                           GridPane.columnIndex="1"
			               prefWidth="380"
						   editable="false"
						   focusTraversable="true"
						   
                           style = "    -fx-background-color: linear-gradient(#1a1a1a, #141414);
    									    -fx-font-weight: bold;
									    -fx-text-fill: #f5c400;
									    -fx-font-size: 18px;
									    -fx-alignment: center;
									    -fx-font-family: monospace;
									    -fx-caret-color: #f5c77a;
									    -fx-border-color: #f5c77a;
    										-fx-effect: dropshadow(gaussian, rgba(245,199,122,0.25), 10, 0, 0, 0);
									    -fx-border-radius: 6;
									    -fx-background-radius: 6;
									    -fx-padding: 10 12;"/>

                    <!-- COPY ICON BUTTON -->
                    <Button fx:id="copyButton"
                            GridPane.columnIndex="2"
                            onAction="#copyCode"
                            styleClass="icon-button">


                        <graphic>
                            <ImageView fitWidth="19"
                                       fitHeight="19"
                                       preserveRatio="true">
                                <image>
                                    <Image url="@/icons/copy.png"/>
                                </image>
                            </ImageView>
                        </graphic>

                    </Button>

                </GridPane>

                <!-- STATUS -->
                <Label fx:id="statusLabel"
                       text="Starting server..."
                       style="-fx-text-fill: #cccccc;
                              -fx-font-size: 14px;" />

                <Region prefHeight="22"/>

                <!-- LEAVE -->
                <Button text="LEAVE"
                        onAction="#leave"
                        styleClass="menu-button-danger"/>

            </VBox>
        </StackPane>
    </StackPane>
</StackPane>
